# Copy to .env.production outside source control; supply real values through your secret manager.
APP_HOST=invoices.example.com
ACME_EMAIL=ops@example.com
DATABASE_URL=postgresql+psycopg://idp:replace-me@postgres.example.com:5432/idp?sslmode=verify-full&sslrootcert=/run/secrets/postgres-ca
POSTGRES_CA_FILE=./certs/postgres-ca.crt
REDIS_URL=rediss://idp:replace-me@redis.example.com:6380/0
JWT_SECRET=replace-me-generate-a-random-64-character-secret
S3_BUCKET=replace-me
S3_ENDPOINT_URL=
S3_SERVER_SIDE_ENCRYPTION=aws:kms
S3_KMS_KEY_ID=replace-me
AWS_REGION=replace-me
EXTRACTION_PROVIDER=bedrock
BEDROCK_MODEL_ID=replace-me
FOUNDRY_MODEL_ENDPOINT=
FOUNDRY_DEPLOYMENT=
FOUNDRY_API_KEY=
COPILOT_PROVIDER=disabled
